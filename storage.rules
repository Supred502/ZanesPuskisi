rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Keep in sync with firestore.rules and lib/firebase.ts (ADMIN_UIDS)
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        "NLL2HDQcDPVezIih8OKLJ0CCaGl2", // Edijs
        "auIgf2eZJkQQffUD0bR4ZYuuArj2", // Loreta
        "hMWGIjyc3uR61GW12VdNYVV49px2"  // Zane
      ];
    }

    // Product photos: public to view; admins upload images (≤ 10 MB) and delete.
    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
