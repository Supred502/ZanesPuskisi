rules_version = '2';
service cloud.firestore {

  // Admin UIDs
  function isAdmin() {
    return request.auth != null
           && request.auth.uid in [
             "NLL2HDQcDPVezIih8OKLJ0CCaGl2", // Admin 1
             "auIgf2eZJkQQffUD0bR4ZYuuArj2"  // Admin 2
           ];
  }

  match /databases/{database}/documents {

    // ------------------
    // USERS (wishlist)
    // ------------------
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /wishlist/{productId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ------------------
    // PRODUCTS
    // ------------------
    match /products/{productId} {
      // Anyone can read products
      allow read: if true;

      // Only admins can add/edit/delete products
      allow write: if isAdmin();

      // ------------------
      // INQUIRIES (public form submissions)
      // ------------------
      match /inquiries/{inquiryId} {
        // Public can create an inquiry; only admins can read/manage them.
        // Keep the payload constrained to reduce spam/abuse and unexpected writes.
        allow create: if request.resource.data.keys().hasOnly([
                        'name',
                        'message',
                        'createdAt',
                        'shareLink',
                        'expiresAt'
                      ])
                      && request.resource.data.name is string
                      && request.resource.data.message is string
                      && request.resource.data.shareLink is string
                      && request.resource.data.expiresAt is timestamp
                      && request.resource.data.name.size() <= 80
                      && request.resource.data.message.size() <= 2000
                      && request.resource.data.shareLink.size() <= 500
                      && (
                        request.resource.data.shareLink.matches('^https?://[^\\s]+/s/[^\\s/]+$')
                        || request.resource.data.shareLink.matches('^/s/[^\\s/]+$')
                      )
                      // serverTimestamp() resolves to request.time in rules
                      && request.resource.data.createdAt == request.time
                      // TTL housekeeping: require expiry within a bounded window.
                      && request.resource.data.expiresAt > request.time
                      && request.resource.data.expiresAt < request.time + duration.value(120, 'd');
        allow read, update, delete: if isAdmin();
      }
    }
  }
}
