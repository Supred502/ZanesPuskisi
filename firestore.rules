rules_version = '2';
service cloud.firestore {

  // Admin UIDs
  function isAdmin() {
    return request.auth != null
           && request.auth.uid in [
             "NLL2HDQcDPVezIih8OKLJ0CCaGl2", // Admin Edijs
             "auIgf2eZJkQQffUD0bR4ZYuuArj2",  // Admin Loreta
             "hMWGIjyc3uR61GW12VdNYVV49px2" // Admin Zane
           ];
  }

  match /databases/{database}/documents {

    // ------------------
    // USERS (wishlist)
    // ------------------
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /wishlist/{productId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ------------------
    // PRODUCTS
    // ------------------
    match /products/{productId} {
      // Anyone can read products
      allow read: if true;

      // Only admins can add/edit/delete products
      allow write: if isAdmin();

      // ------------------
      // INQUIRIES (public form submissions)
      // ------------------
      match /inquiries/{inquiryId} {
        // Public inquiries disabled (WhatsApp-only flow). Admins can still manage if needed.
        allow create: if isAdmin();
        allow read, update, delete: if isAdmin();
      }
    }
  }
}
