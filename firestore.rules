rules_version = '2';
service cloud.firestore {
  // Keep in sync with storage.rules and lib/firebase.ts (ADMIN_UIDS)
  function isAdmin() {
    return request.auth != null && request.auth.uid in [
      "NLL2HDQcDPVezIih8OKLJ0CCaGl2", // Edijs
      "auIgf2eZJkQQffUD0bR4ZYuuArj2", // Loreta
      "hMWGIjyc3uR61GW12VdNYVV49px2"  // Zane
    ];
  }

  function validProduct(d) {
    return d.name is string && d.name.size() > 0 && d.name.size() <= 200
      && d.price is number && d.price > 0
      && d.description is string && d.description.size() <= 5000
      && d.category is string
      && d.available is bool
      && d.holidaySpecial is bool
      && (d.holidayPrice == null || d.holidayPrice is number)
      && (d.tiktokLink == null || (d.tiktokLink is string && d.tiktokLink.matches('https://.*')))
      && d.images is list && d.images.size() <= 20;
  }

  match /databases/{database}/documents {
    // Catalogue: everyone reads, only admins write. Every other collection (old wishlists, inquiries) is closed.
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
